# Contact form email delivery (server-side only)
# Create an API key at https://resend.com and add the same values in Vercel Environment Variables.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# Destination inbox for website contact messages.
CONTACT_TO_EMAIL=milimeasho@gmail.com

# For immediate testing, Resend's onboarding sender can be used.
# For production branding, verify billiontech.ca in Resend and use:
# CONTACT_FROM_EMAIL=Billion Tech Website <website@billiontech.ca>
CONTACT_FROM_EMAIL=Billion Tech Website <onboarding@resend.dev>
